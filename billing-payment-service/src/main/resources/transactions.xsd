<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://roomily.com/billing/soap"
           xmlns:tns="http://roomily.com/billing/soap"
           elementFormDefault="qualified">

    <xs:element name="GetTransactionStatusRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="vnpTxnRef" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetTransactionStatusResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="vnpTxnRef" type="xs:string"/>
                <xs:element name="userId" type="xs:long"/>
                <xs:element name="amount" type="xs:decimal"/>
                <xs:element name="transactionType" type="xs:string"/>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="paymentMethod" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
